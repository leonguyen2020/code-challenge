# ---------------------------------------------------------------------------
# Local infrastructure credentials.
#
# SECURITY: this file is the *template* and is committed. The real `.env` is
# git-ignored. Never commit real credentials, and never reuse these values
# outside a local development machine.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=code-challenge

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=code_challenge
# Bound to loopback only - the container port is never exposed to the LAN.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change_me_local_only
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
