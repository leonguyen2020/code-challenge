{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    /* Node16 replaces the deprecated node10 resolver. It emits CommonJS for
       this package (no "type": "module" in package.json) while using Node's
       real, modern resolution algorithm - conditional exports, "imports" map,
       and correct .cjs/.mjs handling. `module` and `moduleResolution` must
       move together; Node16 is the supported pairing. 
    */
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist",

    /* Maximum type safety. Every one of these has caught a real bug in this
       codebase's history; none are cosmetic. 
    */
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
