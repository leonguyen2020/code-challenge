# ---------------------------------------------------------------------------
# Problem 5 configuration.
#
# The Postgres and Redis credentials are NOT duplicated here: config/env.ts
# loads the repository-root .env first, so the infrastructure passwords live in
# exactly one place. Copy this file to .env only when you need to override
# something for this service specifically.
#
# Precedence (lowest to highest):
#   repository-root .env  ->  src/problem5/.env  ->  real environment variables
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Overrides for the shared infrastructure (optional) --------------------
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=app
# POSTGRES_PASSWORD=
# POSTGRES_DB=code_challenge
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Request handling ------------------------------------------------------
BODY_LIMIT_BYTES=65536
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
SHUTDOWN_TIMEOUT_MS=10000

# Only enable behind a proxy you control - see config/env.ts for why.
TRUST_PROXY=false
